
import requests
import time
import json

DEX_URL = "https://api.dexscreener.com/token-profiles/latest/v1"

with open("config.json", "r") as file:
    config = json.load(file)

def find_tokens():
    try:
        response = requests.get(DEX_URL, timeout=15)
        response.raise_for_status()
        tokens = response.json()

        for token in tokens:
            if token.get("chainId") != "solana":
                continue

            address = token.get("tokenAddress")
            if not address:
                continue

            print("Wykryto token Solana:", address)
            print("Link:", token.get("url"))
            print("-" * 40)

    except Exception as error:
        print("Błąd:", error)

while True:
    find_tokens()